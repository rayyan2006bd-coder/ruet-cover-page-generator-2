{
  "name": "ruet-cover-page",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "packageManager": "bun@1.2.22",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "rsbuild build && bun run post-build.ts",
    "build:api": "bun run --cwd server build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "rsbuild dev --open",
    "dev:api": "bun run --cwd server dev",
    "dev:all": "bun run --parallel dev dev:api",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "bun run --cwd server db:migrate",
    "db:seed": "bun run --cwd server db:seed",
    "data:validate": "bun run --cwd server data:validate",
    "data:duplicates": "bun run --cwd server data:duplicates",
    "test": "bun test",
    "test:api": "bun run --cwd server test",
    "test:e2e": "bun test tests/e2e/cover-workflow.test.ts",
    "test:e2e:responsive": "bun test tests/e2e/responsive-smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "bun run --cwd server typecheck",
    "format": "biome format --write",
    "preview": "rsbuild preview",
    "prepare": "husky",
    "knip": "knip",
    "verify": "bun run check && bun run typecheck && bun run typecheck:api && bun run test && bun run build && bun run build:api"
  },
  "dependencies": {
    "@brillout/json-serializer": "^0.5.23",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@types/http-server": "^0.12.4",
    "baseline-browser-mapping": "^2.10.33",
    "browser-fs-access": "^0.38.0",
    "caniuse-lite": "^1.0.30001793",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.4",
    "inapp-spy": "^5.0.9",
    "jotai": "^2.20.0",
    "jotai-effect": "^2.3.1",
    "lucide-react": "^1.17.0",
    "match-sorter": "^8.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-date-picker": "^12.0.2",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.4.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.1",
    "usehooks-ts": "^3.1.1",
    "workbox-window": "^7.4.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@rsbuild/core": "^1.7.5",
    "@rsbuild/plugin-node-polyfill": "^1.4.5",
    "@rsbuild/plugin-react": "^1.4.6",
    "@rsdoctor/rspack-plugin": "^1.5.12",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "6.2.5",
    "husky": "^9.1.7",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "workbox-cli": "^7.4.1"
  },
  "lint-staged": {
    "*": "biome check --write --unsafe --no-errors-on-unmatched",
    "*.yaml": "prettier --write"
  },
  "prettier": {
    "tabWidth": 2
  },
  "type": "module"
}
