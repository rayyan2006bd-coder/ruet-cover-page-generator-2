NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruet_cover
CORS_ORIGINS=http://localhost:3000

# Optional compatibility token for existing maintenance scripts. Generate the
# hash with `bun run admin:hash`; never commit the raw token.
ADMIN_TOKEN_HASH=

# Used only by `bun run admin:create-user`. Keep ADMIN_PASSWORD out of shell
# history by loading it from a private local environment file or prompt wrapper.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_ROLE=owner

LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
