{
  "name": "@ruet-cover-page/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "data:validate": "bun run src/data/validate.ts",
    "data:duplicates": "bun run src/data/duplicates.ts",
    "admin:hash": "bun run src/utils/hash-admin-token.ts",
    "admin:create-user": "bun run src/admin/create-user.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.7.6",
    "drizzle-orm": "0.44.7",
    "hono": "4.13.1",
    "postgres": "3.4.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3"
  }
}
